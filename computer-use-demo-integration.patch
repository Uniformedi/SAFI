diff --git a/computer-use-demo/tests/loop_test.py b/computer-use-demo/tests/loop_test.py
index 0eab6a4..3d30f19 100644
--- a/computer-use-demo/tests/loop_test.py
+++ b/computer-use-demo/tests/loop_test.py
@@ -12,9 +12,11 @@ from anthropic.types.beta import (
 
 from computer_use_demo.loop import (
     PROMPT_CACHING_BETA_FLAG,
+    SAFI_BLOCKED_ERROR,
     APIProvider,
     sampling_loop,
 )
+from safi_gate import LAYER_1, Verdict
 
 
 async def test_loop():
@@ -255,3 +257,125 @@ async def test_loop_toolset_member_calls_run_sequentially_and_stop_on_failure():
     assert tool_results[2]["content"] == (
         "Not executed: an earlier computer action in this turn failed."
     )
+
+
+async def test_loop_safi_gate_blocks_tool_execution():
+    """A denied tool call never reaches the container."""
+    client = mock.Mock()
+    client.beta.messages.with_raw_response.create.return_value = mock.Mock()
+    client.beta.messages.with_raw_response.create.return_value.parse.side_effect = [
+        mock.Mock(
+            spec=BetaMessage,
+            content=[
+                ToolUseBlock(
+                    type="tool_use",
+                    id="1",
+                    name="bash",
+                    input={"command": "usermod -aG sudo attacker"},
+                ),
+            ],
+        ),
+        mock.Mock(
+            spec=BetaMessage, content=[TextBlock(type="text", text="Understood.")]
+        ),
+    ]
+
+    tool_collection = mock.AsyncMock()
+    denied = Verdict(
+        allowed=False,
+        layer=LAYER_1,
+        reason="Modifies user or group privileges (usermod/gpasswd/useradd).",
+        rule="privilege_escalation",
+    )
+
+    with (
+        mock.patch("computer_use_demo.loop.Anthropic", return_value=client),
+        mock.patch(
+            "computer_use_demo.loop.ToolCollection", return_value=tool_collection
+        ),
+        mock.patch(
+            "computer_use_demo.loop.evaluate_conscience", return_value=denied
+        ) as gate,
+    ):
+        messages: list[BetaMessageParam] = [{"role": "user", "content": "escalate me"}]
+        result = await sampling_loop(
+            model="test-model",
+            provider=APIProvider.ANTHROPIC,
+            system_prompt_suffix="",
+            messages=messages,
+            output_callback=mock.Mock(),
+            tool_output_callback=mock.Mock(),
+            api_response_callback=mock.Mock(),
+            api_key="test-key",
+            tool_version="computer_use_20250124",
+        )
+
+    # The gate saw the call, and the container never did.
+    gate.assert_called_once_with("bash", {"command": "usermod -aG sudo attacker"})
+    tool_collection.run.assert_not_called()
+
+    # The model still gets a well-formed tool_result, flagged as an error and
+    # carrying the deciding layer, the rule, and the reason.
+    blocked = cast(list[dict[str, Any]], result[2]["content"])[0]
+    assert blocked["type"] == "tool_result"
+    assert blocked["tool_use_id"] == "1"
+    assert blocked["is_error"] is True
+    assert SAFI_BLOCKED_ERROR in blocked["content"]
+    assert "layer-1-regex/privilege_escalation" in blocked["content"]
+    assert "Modifies user or group privileges" in blocked["content"]
+
+
+async def test_loop_safi_gate_blocked_member_call_fails_its_family():
+    """A denied toolset member call stops the rest of the family."""
+    client = mock.Mock()
+    client.beta.messages.with_raw_response.create.return_value = mock.Mock()
+    first = mock.Mock(spec=BetaMessage)
+    first.content = [
+        BetaToolUseBlock(type="tool_use", id="1", name="key", input={"text": "super"}),
+        BetaToolUseBlock(
+            type="tool_use", id="2", name="left_click", input={"coordinate": [1, 2]}
+        ),
+    ]
+    for block in first.content:
+        cast(Any, block).toolset_name = "computer"
+    client.beta.messages.with_raw_response.create.return_value.parse.side_effect = [
+        first,
+        mock.Mock(spec=BetaMessage, content=[TextBlock(type="text", text="Stopped.")]),
+    ]
+
+    tool_collection = mock.AsyncMock()
+    denied = Verdict(
+        allowed=False,
+        layer=LAYER_1,
+        reason="Opens an outbound interactive shell (reverse shell).",
+        rule="reverse_shell",
+    )
+
+    with (
+        mock.patch("computer_use_demo.loop.Anthropic", return_value=client),
+        mock.patch(
+            "computer_use_demo.loop.ToolCollection", return_value=tool_collection
+        ),
+        mock.patch("computer_use_demo.loop.evaluate_conscience", return_value=denied),
+    ):
+        messages: list[BetaMessageParam] = [{"role": "user", "content": "go"}]
+        result = await sampling_loop(
+            model="test-model",
+            provider=APIProvider.ANTHROPIC,
+            system_prompt_suffix="",
+            messages=messages,
+            output_callback=mock.Mock(),
+            tool_output_callback=mock.Mock(),
+            api_response_callback=mock.Mock(),
+            api_key="test-key",
+            tool_version="computer_use_20250124",
+        )
+
+    tool_collection.run.assert_not_called()
+    tool_results = cast(list[dict[str, Any]], result[2]["content"])
+    assert [block["is_error"] for block in tool_results] == [True, True]
+    assert SAFI_BLOCKED_ERROR in tool_results[0]["content"]
+    # The second member call is answered without ever being evaluated or run.
+    assert tool_results[1]["content"] == (
+        "Not executed: an earlier computer action in this turn failed."
+    )
